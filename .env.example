# Copy this file to .env and fill in real values before running the app.

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=Spenza
APP_ENV=dev
APP_VERSION=1.0.0
DEBUG=true

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
TIMEOUT=240
GRACEFUL_TIMEOUT=60

# ── Database ─────────────────────────────────────────────────────────────
# Local dev, e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17`
# Use a dedicated database name (run `make create-db` to create it) rather
# than pointing at a Postgres instance shared with other projects.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spenza
# Production example (Supabase):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<project>.supabase.co:5432/postgres
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── JWT / Auth ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Cookies ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/

# ── CORS / Trusted hosts ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Email / SMTP ───────────────────────────────────────────────────────────
# EMAIL_BACKEND=console logs emails instead of sending them (dev/test default).
# Set EMAIL_BACKEND=smtp in production with real Gmail SMTP credentials below.
EMAIL_BACKEND=console
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-16-character-app-specific-password
SENDER_NAME=Spenza

# ── OTP ────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_CLEANUP_INTERVAL_SECONDS=604800

# ── Account lockout ────────────────────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Password policy ────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_OTP=5/minute

# ── Logging ──────────────────────────────────────────────────────────────
# Leave unset to use the per-environment default (files on in dev/test, off
# in prod). Uncomment to override in either direction, e.g. to also write
# logs/app.log + logs/error.log in production:
# LOG_TO_FILE=true

# ── Import / Export ────────────────────────────────────────────────────────
MAX_IMPORT_FILE_SIZE_BYTES=10485760
MAX_IMPORT_ROWS=10000
IMPORT_SESSION_EXPIRE_MINUTES=30
MAX_EXPORT_ROWS=50000
