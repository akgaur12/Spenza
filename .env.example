# Copy this file to .env and fill in real values before running the app.

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=Spenza
APP_ENV=dev
APP_VERSION=1.0.0
DEBUG=true
# Used to compute "today"/"this week"/"this month"/"this year" boundaries
# app-wide (e.g. the dashboard) — there is no per-user timezone yet.
APP_TIMEZONE=Asia/Kolkata

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info
TIMEOUT=240
GRACEFUL_TIMEOUT=60

# ── Database ─────────────────────────────────────────────────────────────
# Local dev, e.g. `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17`
# Use a dedicated database name (run `make create-db` to create it) rather
# than pointing at a Postgres instance shared with other projects.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spenza
# Production example (Supabase):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<project>.supabase.co:5432/postgres
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── JWT / Auth ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Cookies ────────────────────────────────────────────────────────────────
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_PATH=/

# ── CORS / Trusted hosts ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Email / SMTP ───────────────────────────────────────────────────────────
# EMAIL_BACKEND=console logs emails instead of sending them (dev/test default).
# EMAIL_BACKEND=smtp sends via raw SMTP (SMTP_* + SMTP_SENDER_EMAIL +
# SENDER_PASSWORD below) — most cloud hosts (e.g. Render) block outbound SMTP
# ports, so this only reliably works when self-hosting or on a host that
# allows it.
# EMAIL_BACKEND=resend sends via the Resend HTTP API (RESEND_API_KEY +
# RESEND_SENDER_EMAIL below) — works anywhere outbound HTTPS is allowed.
# RESEND_SENDER_EMAIL's domain must be verified in the Resend dashboard first.
# EMAIL_BACKEND=mailjet sends via the Mailjet Send API v3.1 (MAILJET_API_KEY +
# MAILJET_API_SECRET + MAILJET_SENDER_EMAIL below) — same HTTPS-only
# rationale as Resend. MAILJET_SENDER_EMAIL's domain must be verified in the
# Mailjet dashboard first.
# Each backend has its own *_SENDER_EMAIL because each requires independent
# domain/mailbox verification with that specific provider.
EMAIL_BACKEND=console
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-16-character-app-specific-password
SENDER_NAME=Spenza
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER_EMAIL=

# ── OTP ────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Account lockout ────────────────────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Password policy ────────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_OTP=5/minute

# ── Logging ──────────────────────────────────────────────────────────────
# Leave unset to use the per-environment default (files on in dev/test, off
# in prod). Uncomment to override in either direction, e.g. to also write
# logs/app.log + logs/error.log in production:
# LOG_TO_FILE=true

# ── Import / Export ────────────────────────────────────────────────────────
MAX_IMPORT_FILE_SIZE_BYTES=10485760
MAX_IMPORT_ROWS=10000
IMPORT_SESSION_EXPIRE_MINUTES=30
MAX_EXPORT_ROWS=50000

# ── Recurring expenses ───────────────────────────────────────────────────
# Daily due-recurrence job run time, in APP_TIMEZONE.
RECURRING_EXPENSE_SCHEDULER_HOUR=1
RECURRING_EXPENSE_SCHEDULER_MINUTE=0

# ── Scheduled email delivery (notifications) ──────────────────────────────
# Retry/backoff for a single notification email send.
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY_SECONDS=2.0
# How often the safety-net sweep re-attempts any notification email that
# never resolved to SUCCESS or exhausted FAILED.
NOTIFICATION_EMAIL_JOB_INTERVAL_MINUTES=360
# Monthly/yearly report jobs run daily (in APP_TIMEZONE) but only actually
# generate/send a report on the configured day (and, for yearly, month).
MONTHLY_REPORT_SCHEDULER_HOUR=6
MONTHLY_REPORT_SCHEDULER_MINUTE=0
MONTHLY_REPORT_DELIVERY_DAY=1
YEARLY_REPORT_SCHEDULER_HOUR=6
YEARLY_REPORT_SCHEDULER_MINUTE=30
YEARLY_REPORT_DELIVERY_DAY=1
YEARLY_REPORT_DELIVERY_MONTH=1

# ── AI Assistant ───────────────────────────────────────────────────────────
# AI_DEFAULT_PROVIDER selects which of the 7 providers below backs a new
# chat when the client doesn't specify one. AI_DEFAULT_MODEL is that
# provider's model name (e.g. "llama3.1:8b" for ollama, "gpt-4.1-mini" for
# openai). Every provider below is optional — only configure the ones you
# actually use; sending a message on an unconfigured provider fails fast
# with a clean AI_PROVIDER_UNAVAILABLE error, before anything streams.
AI_DEFAULT_PROVIDER=ollama
AI_DEFAULT_MODEL=ornith:9b
# Ollama (local/self-hosted) — base URL only, no API key.
OLLAMA_BASE_URL=http://localhost:11434
# AWS Bedrock — region is required; access key/secret are optional (falls
# back to boto3's normal credential chain — env vars, shared config,
# instance role, ...).
AWS_BEDROCK_REGION=
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
OPEN_ROUTER_API_KEY=
# Wall-clock budgets so a slow/unreachable provider or tool can never hang
# a request indefinitely.
AI_LLM_TIMEOUT_SECONDS=30.0
AI_TOOL_TIMEOUT_SECONDS=15.0
AI_AGENT_TIMEOUT_SECONDS=90.0
# How many of a chat's most recent messages are loaded into the agent's
# context window on each new message.
AI_CONTEXT_WINDOW_MESSAGES=30
AI_CHAT_REQUESTS_PER_MINUTE=10/minute
# Generates a short chat title asynchronously after the first message,
# without blocking that message's response. Keeps "New Chat" on failure.
AI_TITLE_GENERATION_ENABLED=true

# ── Data retention / cleanup ───────────────────────────────────────────────
# A single daily job (in APP_TIMEZONE) purges stale rows from
# notification_delivery_logs, notifications, import_sessions, and
# refresh_sessions so none of them grow unbounded (email_otps is cleaned up
# by the same job, on its own retention logic — see cleanup_expired_otps).
NOTIFICATION_CLEANUP_SCHEDULER_HOUR=3
NOTIFICATION_CLEANUP_SCHEDULER_MINUTE=0
DELIVERY_LOG_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=60
IMPORT_SESSION_RETENTION_DAYS=2
REFRESH_SESSION_RETENTION_DAYS=30
USER_UNVERIFIED_RETENTION_DAYS=7
